{% extends 'base.html.twig' %}

{% block title %}{{ titulo }}{% endblock %}

{% block body %}
    <h1 class="h3 mb-4">{{ titulo }}</h1>

    {% set idsAutores = [] %}
    {% for autor in form.autores.vars.data|default([]) %}
        {% set idsAutores = idsAutores|merge([autor.id]) %}
    {% endfor %}

    {% set idsAssuntos = [] %}
    {% for assunto in form.assuntos.vars.data|default([]) %}
        {% set idsAssuntos = idsAssuntos|merge([assunto.id]) %}
    {% endfor %}

    {{ form_start(form) }}
        <div class="row">
            <div class="col-md-8">{{ form_row(form.titulo) }}</div>
            <div class="col-md-4">{{ form_row(form.editora) }}</div>
        </div>

        <div class="row">
            <div class="col-md-4">{{ form_row(form.edicao) }}</div>
            <div class="col-md-4">{{ form_row(form.anoPublicacao) }}</div>
            <div class="col-md-4">{{ form_row(form.valor) }}</div>
        </div>

        <div class="row mt-2">
            <div class="col-lg-6 mb-3">
                {{ component('SelecaoRegistros', {
                    tipo: 'autor',
                    campo: form.autores.vars.full_name,
                    rotulo: 'Autores',
                    obrigatorio: true,
                    selecionados: idsAutores,
                }) }}
                {{ form_errors(form.autores) }}
                {% do form.autores.setRendered %}
            </div>

            <div class="col-lg-6 mb-3">
                {{ component('SelecaoRegistros', {
                    tipo: 'assunto',
                    campo: form.assuntos.vars.full_name,
                    rotulo: 'Assuntos',
                    selecionados: idsAssuntos,
                }) }}
                {{ form_errors(form.assuntos) }}
                {% do form.assuntos.setRendered %}
            </div>
        </div>

        <div class="d-flex gap-2 border-top pt-3 mt-3">
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a class="btn btn-outline-secondary" href="{{ path('livro_index') }}">Cancelar</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
