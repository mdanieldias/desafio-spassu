<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Livraria{% endblock %}</title>
        <script>
            try {
                if (localStorage.getItem('sidebar-collapsed') === '1') {
                    document.documentElement.classList.add('sidebar-collapsed');
                }
            } catch (e) {}
        </script>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
            <symbol id="book" viewBox="0 0 16 16" fill="currentColor">
                <path fill="currentColor" d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783"/>
            </symbol>
            <symbol id="people" viewBox="0 0 16 16" fill="currentColor">
                <path fill="currentColor" d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-1A.26.26 0 0 1 7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002a.27.27 0 0 1-.014.002zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4m3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0M6.936 9.28a6 6 0 0 0-1.23-.247A7 7 0 0 0 5 9c-4 0-5 3-5 4 0 .667.333 1 1 1h4.216A2.24 2.24 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816M4.92 10A5.5 5.5 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275zM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0m3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4"/>
            </symbol>
            <symbol id="bookmark" viewBox="0 0 16 16" fill="currentColor">
                <path fill="currentColor" d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v13.5a.5.5 0 0 1-.777.416L8 13.101l-5.223 2.815A.5.5 0 0 1 2 15.5zm2-1a1 1 0 0 0-1 1v12.566l4.723-2.482a.5.5 0 0 1 .554 0L13 14.566V2a1 1 0 0 0-1-1z"/>
            </symbol>
            <symbol id="chevron-left" viewBox="0 0 16 16" fill="currentColor">
                <path fill="currentColor" fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
            </symbol>
            <symbol id="list" viewBox="0 0 16 16" fill="currentColor">
                <path fill="currentColor" fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"/>
            </symbol>
            <symbol id="x" viewBox="0 0 16 16" fill="currentColor">
                <path fill="currentColor" d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
            </symbol>
        </svg>

        {% set rota = app.request.attributes.get('_route') %}
        <div class="d-flex flex-column flex-md-row min-vh-100">
            <aside class="sidebar d-flex flex-column flex-shrink-0 px-3 py-2 p-md-3 text-bg-dark" data-controller="sidebar">
                <div class="sidebar-header d-flex align-items-center mb-md-3">
                    <a href="{{ path('livro_index') }}" class="sidebar-brand d-flex align-items-center me-auto text-white text-decoration-none" data-sidebar-tooltip data-bs-title="Livraria">
                        <svg class="bi pe-none me-2" width="32" height="32" fill="currentColor"><use href="#book"/></svg>
                        <span class="sidebar-label fs-4">Livraria</span>
                    </a>
                    <button type="button" class="sidebar-toggle btn btn-sm text-white" data-action="sidebar#toggle" data-sidebar-tooltip data-bs-title="Expandir menu" aria-expanded="true" aria-controls="menu-principal" aria-label="Recolher menu">
                        <svg class="sidebar-chevron bi pe-none" width="16" height="16" fill="currentColor"><use href="#chevron-left"/></svg>
                        <svg class="sidebar-burger bi pe-none" width="24" height="24" fill="currentColor"><use href="#list"/></svg>
                        <svg class="sidebar-close bi pe-none" width="24" height="24" fill="currentColor"><use href="#x"/></svg>
                    </button>
                </div>
                <hr class="sidebar-divider">
                <ul id="menu-principal" class="nav nav-pills nav-flush flex-column mb-auto">
                    <li class="nav-item">
                        <a href="{{ path('livro_index') }}" class="nav-link {{ rota starts with 'livro' or rota == 'home' ? 'active' : 'text-white' }}" data-sidebar-tooltip data-bs-title="Livros" {% if rota starts with 'livro' or rota == 'home' %}aria-current="page"{% endif %}>
                            <svg class="bi pe-none me-2" width="16" height="16" fill="currentColor"><use href="#book"/></svg>
                            <span class="sidebar-label">Livros</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('autor_index') }}" class="nav-link {{ rota starts with 'autor' ? 'active' : 'text-white' }}" data-sidebar-tooltip data-bs-title="Autores" {% if rota starts with 'autor' %}aria-current="page"{% endif %}>
                            <svg class="bi pe-none me-2" width="16" height="16" fill="currentColor"><use href="#people"/></svg>
                            <span class="sidebar-label">Autores</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('assunto_index') }}" class="nav-link {{ rota starts with 'assunto' ? 'active' : 'text-white' }}" data-sidebar-tooltip data-bs-title="Assuntos" {% if rota starts with 'assunto' %}aria-current="page"{% endif %}>
                            <svg class="bi pe-none me-2" width="16" height="16" fill="currentColor"><use href="#bookmark"/></svg>
                            <span class="sidebar-label">Assuntos</span>
                        </a>
                    </li>
                </ul>
            </aside>
            <main class="main-content flex-grow-1 p-3 p-md-4">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label }}" role="alert">{{ message }}</div>
                    {% endfor %}
                {% endfor %}
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>
