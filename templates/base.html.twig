<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Cadastro de livros{% endblock %}</title>
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-dark bg-dark mb-4">
            <div class="container d-flex align-items-center gap-3">
                <a class="navbar-brand" href="{{ path('livro_index') }}">Cadastro de livros</a>
                <a class="nav-link text-white" href="{{ path('livro_index') }}">Livros</a>
                <a class="nav-link text-white" href="{{ path('autor_index') }}">Autores</a>
                <a class="nav-link text-white" href="{{ path('assunto_index') }}">Assuntos</a>
            </div>
        </nav>
        <main class="container pb-5">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}" role="alert">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
