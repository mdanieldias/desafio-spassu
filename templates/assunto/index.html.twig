{% extends 'base.html.twig' %}

{% block title %}Assuntos{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Assuntos</h1>
        <a class="btn btn-primary" href="{{ path('assunto_novo') }}">Novo assunto</a>
    </div>

    {% if assuntos is empty %}
        <p class="text-secondary mb-0">Nenhum assunto cadastrado.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th scope="col">Descrição</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {% for assunto in assuntos %}
                        <tr>
                            <td>{{ assunto.descricao }}</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" href="{{ path('assunto_editar', {id: assunto.id}) }}">Editar</a>
                                <form class="d-inline" method="post" action="{{ path('assunto_excluir', {id: assunto.id}) }}" onsubmit="return confirm('Excluir este assunto?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('assunto_excluir') }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
